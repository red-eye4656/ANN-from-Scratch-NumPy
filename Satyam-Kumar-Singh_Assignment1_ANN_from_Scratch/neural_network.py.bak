import numpy as np



def sigmoid(z):
    return 1/ (1 +np.exp(-z))

def relu(z):
    return np.maximum(0, z)


def relu_derivative(z):
    return (z > 0).astype(float)


def tanh(z):
    return np.tanh(z)


def tanh_derivative(z):
    return 1 - np.tanh(z) ** 2

def sigmoid_derivative(z):
    s = sigmoid(z)
    return s * (1 - s)

def activation_function(z, name):
    if name == "sigmoid":
        return sigmoid(z)
    elif name == "relu":
        return relu(z)
    elif name == "tanh":
        return tanh(z)
    else:
        raise ValueError(f"Unsupported activation: {name}")


def activation_derivative(z, name):
    if name == "sigmoid":
        return sigmoid_derivative(z)
    elif name == "relu":
        return relu_derivative(z)
    elif name == "tanh":
        return tanh_derivative(z)
    else:
        raise ValueError(f"Unsupported activation: {name}")

def softmax(z):
    exp_z = np.exp(z - np.max(z, axis=-1, keepdims=True))
    return exp_z/ np.sum(exp_z, axis=-1, keepdims=True)

def initialize_parameters():
  w1 = np.random.randn(4, 8) * np.sqrt(1/4)
  w2 = np.random.randn(8, 6) * np.sqrt(1/8)
  w3 = np.random.randn(6, 3) * np.sqrt(1/6)
  b1 = np.zeros((1, 8))
  b2 = np.zeros((1, 6))
  b3 = np.zeros((1, 3))
  return w1, b1, w2, b2, w3, b3





def cross_entropy_loss(y_true, y_pred):
    epsilon = 1e-12
    y_pred = np.clip(y_pred, epsilon, 1 - epsilon)

    loss = -np.mean(np.sum(y_true * np.log(y_pred), axis=1))
    return loss



def forward_propagation(X, w1, b1, w2, b2, w3, b3, activation="sigmoid", return_cache=False):
    z1 = np.dot(X, w1) + b1
    A1 = activation_function(z1, activation)

    z2 = np.dot(A1, w2) + b2
    A2 = activation_function(z2, activation)

    z3 = np.dot(A2, w3) + b3
    A3 = softmax(z3)

    if return_cache:
     return A1, A2, A3, z1, z2
    return A1, A2, A3

def backward_propagation(X, y, A1, A2, A3, w2, w3, z1=None, z2=None, activation="sigmoid"):
    m = X.shape[0]
    dz3 = (A3 - y) / m

    dw3 = np.dot(A2.T, dz3)
    db3 = np.sum(dz3, axis=0, keepdims=True)


    dz2 = np.dot(dz3, w3.T) * A2 * (1 - A2)
    dw2 = np.dot(A1.T, dz2)
    db2 = np.sum(dz2, axis=0, keepdims=True)

    
    dz1 = np.dot(dz2, w2.T) * A1 * (1 - A1)
    dw1 = np.dot(X.T, dz1)
    db1 =np.sum(dz1, axis=0, keepdims=True)

    return dw1, db1, dw2, db2, dw3, db3

def update_parameters(w1, b1, w2, b2, w3, b3, dw1, db1, dw2, db2, dw3, db3, learning_rate):
    w1  = w1 - learning_rate * dw1
    b1 = b1 -  learning_rate * db1

    w2 = w2 - learning_rate * dw2
    b2 = b2 - learning_rate * db2

    w3 = w3 - learning_rate * dw3
    b3 = b3 - learning_rate  * db3

    return w1, b1, w2, b2, w3, b3


def accuracy_score(y_true, y_pred):
    correct = np.argmax(y_true, axis=1)
    predicted = np.argmax(y_pred, axis=1)
    return np.mean(correct == predicted)